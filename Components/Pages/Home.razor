@page "/"

<PageTitle>DbSchemaExplorer</PageTitle>

<div style="max-width:600px; margin:80px auto; text-align:center; font-family:Arial,sans-serif;">
    <h1 style="font-size:2.2rem; font-weight:800; color:#1e293b;">🗄️ DbSchemaExplorer</h1>
    <p style="color:#64748b; font-size:1.1rem; margin:16px 0 40px;">
        Connect to any MySQL or SQL Server database and instantly explore its tables,
        columns, relationships, and ER diagrams — read-only and secure.
    </p>
    <a href="/Connect" style="display:inline-block; background:#4f46e5; color:#fff;
        text-decoration:none; padding:16px 48px; border-radius:10px; font-size:1.1rem;
        font-weight:700; box-shadow:0 4px 14px rgba(79,70,229,0.4);">
        🚀 Open Explorer
    </a>
    <p style="color:#94a3b8; font-size:0.85rem; margin-top:32px;">
        Only schema metadata is read — your data is never accessed.
    </p>
</div>
